# ESP32-P4 + USB UVC 카메라 + WebRTC 기본 설정
# (menuconfig 에서 바꾼 값은 sdkconfig 에 저장되고, 이 파일은 처음 한 번만 적용됩니다)
CONFIG_IDF_TARGET="esp32p4"

# 플래시 / 파티션 (앱 영역 3MB — 4MB 이상 플래시면 어떤 보드든 OK)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM: USB 프레임 버퍼, 디코드/인코드 버퍼, RTP 송신 풀이 전부 여기 들어간다
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# WebRTC: DTLS-SRTP + 자체 서명 인증서 생성
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# USB 호스트 (UVC)
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# HTTP 서버: 브라우저 헤더가 기본값(512)보다 길 때가 있다
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=256

# 브라우저가 IP 를 숨기려고 쓰는 xxxx.local ICE 후보를 풀기 위해
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y

# WiFi: ESP32-P4-Function-EV-Board 의 ESP32-C6 (SDIO, esp_hosted)
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
